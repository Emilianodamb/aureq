---
import AnimatedIcon from './AnimatedIcon.astro';

const steps = [
  {
    title: '1. Relevamiento inicial',
    text: 'Nos reunimos para entender el estado actual, tus objetivos y tus servicios principales. Definimos qué necesita tu negocio para empezar a vender más.',
    icon: 'clipboard-list',
  },
  {
    title: '2. Arquitectura y diseño',
    text: 'Definimos la estructura del sitio y la propuesta visual. Te entregamos un diseño funcional, pensado para tu cliente ideal.',
    icon: 'pen-tool',
  },
  {
    title: '3. Desarrollo e implementación',
    text: 'Construimos la web bajo estándares de calidad, configurando tu dominio, los servidores y las vías de contacto directo.',
    icon: 'code',
  },
  {
    title: '4. Puesta en marcha y soporte',
    text: 'Publicamos el sitio tras las pruebas necesarias y te acompañamos de forma continua para que tu presencia digital crezca con vos.',
    icon: 'rocket',
  },
];
---

<section class="process" id="como-trabajamos">
  <div class="container">
    <div class="section-heading section-heading--center process__header">
      <h2 class="section-heading__title">Cómo trabajamos en Aureq</h2>
      <p class="section-heading__text">
        Nos encargamos de todo de principio a fin para tener tu web profesional
        lista en una semana. Avanzamos con pasos firmes para acercarte al
        resultado de forma efectiva.
      </p>
    </div>

    <div class="process__grid">
      {
        steps.map((step) => (
          <article class="process__step">
            <div class="process__icon">
              <AnimatedIcon name={step.icon} hoverOn=".process__step" />
            </div>
            <h3 class="process__title">{step.title}</h3>
            <p class="process__text">{step.text}</p>
          </article>
        ))
      }
    </div>

    <div class="process__actions">
      <a class="button button--surface button--sm" href="#contacto">Empezá tu proyecto</a>
      <a class="process__link" href="#precios">Ver precios <span aria-hidden="true">›</span></a>
    </div>
  </div>
</section>
