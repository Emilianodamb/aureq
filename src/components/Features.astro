---
import AnimatedIcon from './AnimatedIcon.astro';

const items = [
  {
    text: '<strong>Te guiamos y acompañamos desde el primer día</strong> para definir juntos el rumbo de tu espacio digital.',
    icon: 'compass',
  },
  {
    text: 'Relevamos tu actividad para ordenar la información, estructurar una propuesta clara y <strong>hablarle directamente a tu cliente ideal</strong>.',
    icon: 'target',
  },
  {
    text: 'Conectamos <strong>tu página con tu WhatsApp</strong> para un contacto directo, con un solo clic.',
    icon: 'message-circle',
  },
  {
    text: 'Redactamos y estructuramos los textos para <strong>comunicar el verdadero valor de tu trabajo</strong>.',
    icon: 'type',
  },
  {
    text: 'Posicionamiento SEO para <strong>que tu sitio destaque en las búsquedas</strong> de forma orgánica, sin pagar anuncios.',
    icon: 'search',
  },
  {
    text: 'Diseñamos una <strong>web adaptada a celulares</strong> y una estructura límpia, para una lectura impecable en cualquier pantalla.',
    icon: 'smartphone',
  },
  {
    text: '<strong>Gestionamos el registro de tu dominio (.com o .com.ar), los servidores de alto rendimiento y la seguridad SSL.</strong>',
    icon: 'globe',
  },
  {
    text: 'Dejamos el sitio preparado según las <strong>normativas vigentes y políticas de privacidad</strong>, para tu total tranquilidad.',
    icon: 'shield',
  },
];
---

<section class="features">
  <div class="container features__inner">
    <div class="features__content">
      <h2 class="features__title">Todo lo que tu negocio necesita, resuelto de punta a punta.</h2>
      <p class="features__text">
        Nos ocupamos de cada detalle técnico, visual y comercial para que vos te
        enfoques en atender a tu clientela y hacer crecer tu actividad.
      </p>

      <ul class="features__list">
        {
          items.map((item) => (
            <li class="features__item">
              <span class="features__icon">
                <AnimatedIcon name={item.icon} hoverOn=".features__item" />
              </span>
              <span class="features__item-text" set:html={item.text} />
              <span class="features__check" aria-hidden="true">✓</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="features__preview" aria-hidden="true">
      <div class="features__preview-bar">
        <span>tu-negocio.com</span>
        <span class="features__preview-dots">
          <span class="features__preview-dot"></span>
          <span class="features__preview-dot"></span>
          <span class="features__preview-dot features__preview-dot--active"></span>
        </span>
      </div>

      <div class="features__mock-hero">
        <span class="features__mock-bar features__mock-bar--accent"></span>
        <span class="features__mock-bar features__mock-bar--wide"></span>
      </div>

      <div class="features__mock-grid">
        <div class="features__mock-card">
          <span class="features__mock-icon"></span>
          <span class="features__mock-bar"></span>
        </div>
        <div class="features__mock-card">
          <span class="features__mock-icon"></span>
          <span class="features__mock-bar"></span>
        </div>
      </div>

      <div class="features__mock-cta">
        <span class="features__mock-bar features__mock-bar--wide"></span>
        <span class="features__mock-button"></span>
      </div>
    </div>
  </div>
</section>
