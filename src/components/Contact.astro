---
const whatsappUrl =
  'https://wa.me/5491124012037?text=Hola%20Aureq%2C%20quiero%20consultar%20por%20una%20p%C3%A1gina%20web.';
---

<section class="contact" id="contacto">
  <div class="container contact__inner">
    <h2 class="contact__title">Si te quedaste con dudas, consultanos sin compromiso</h2>
    <p class="contact__text">Escribinos y te respondemos lo antes posible.</p>

    <div class="contact__actions">
      <a
        class="button button--primary"
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Escribinos por WhatsApp
      </a>
    </div>
  </div>
</section>
